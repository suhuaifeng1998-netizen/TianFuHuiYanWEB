{
  "name": "tianfu-huiyan-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "setup": "node scripts/manage-apps.mjs setup",
    "dev": "node scripts/manage-apps.mjs dev portal",
    "dev:robot": "node scripts/manage-apps.mjs dev robot",
    "connect:online": "node scripts/connect-online.mjs",
    "check:connection": "node scripts/check-connection.mjs",
    "test:connection": "node --test scripts/dev-proxy.test.mjs",
    "build": "node scripts/manage-apps.mjs build",
    "preview": "node scripts/manage-apps.mjs preview",
    "preview:materials": "python materials-ui/preview.py",
    "check:materials": "python -m unittest discover -s materials-ui/tests -v",
    "test:materials-upload": "node --test materials-ui/tests/upload-progress.test.mjs",
    "check:source": "node scripts/check-source.mjs"
  }
}
