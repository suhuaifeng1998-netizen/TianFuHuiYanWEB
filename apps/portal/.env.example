# Public browser configuration only. Never put credentials in VITE_* values.
# Empty uses same-origin /api routes. Also accepts an HTTP(S) origin or /path prefix.
VITE_API_BASE=

# Optional Vite development proxy target (HTTP(S)); empty disables the proxy.
# Use with an empty VITE_API_BASE. This is not a production server configuration.
# Recommended: npm run connect:online -- --target <public API origin> (at repo root).
VITE_DEV_PROXY_TARGET=

# Optional workbench entry URLs; empty keeps the current same-origin routes.
VITE_ROBOT_ENTRY=
VITE_MATERIALS_ENTRY=
